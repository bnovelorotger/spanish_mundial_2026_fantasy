# ============================================================
# World Cup 2026 Pick'em — Environment variables (example)
# ============================================================
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# Never commit `.env.local`.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# Everything else is SERVER ONLY — never read it from a Client Component.
# ============================================================


# ------------------------------------------------------------
# Supabase — public (safe to expose in the browser)
# ------------------------------------------------------------
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key


# ------------------------------------------------------------
# Supabase — secret (SERVER ONLY, NEVER expose to the browser)
# ------------------------------------------------------------
# Service role bypasses RLS. Only used by:
#   - /lib/supabase/admin.ts
#   - /scripts/*
#   - /app/api/sync/route.ts
# If this leaks, rotate it immediately in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ------------------------------------------------------------
# Sync endpoint protection
# ------------------------------------------------------------
# Shared secret between the GitHub Action and POST /api/sync.
# Generate a random value, e.g. `openssl rand -hex 32`.
CRON_SECRET=replace-with-a-long-random-string


# ------------------------------------------------------------
# World Cup data provider
# ------------------------------------------------------------
# Which provider sync.service.ts uses. Valid values:
#   - mock         (default for MVP 1, no external calls)
#   - static       (bundled JSON, no external calls)
#   - apifootball  (real provider — Phase 11+, requires WORLD_CUP_API_KEY)
WORLD_CUP_API_PROVIDER=mock

# Only required when WORLD_CUP_API_PROVIDER=apifootball.
WORLD_CUP_API_KEY=


# ------------------------------------------------------------
# App base URL
# ------------------------------------------------------------
# Used for client-side links / canonical URLs.
# Locally this is http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side URL used by scripts and GitHub Actions when they need to call
# the deployed app (e.g. POST /api/sync). In production this is the Vercel URL.
APP_URL=http://localhost:3000
